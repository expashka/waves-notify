# ── General ────────────────────────────────────────────────
SITE_NAME=My Site          # shown in notifications
PORT=8080                  # service port inside container
NOTIFY_SECRET=             # token for POST /notify (leave empty to disable auth)

# ── Telegram ────────────────────────────────────────────────
TG_BOT_TOKEN=              # from @BotFather
TG_ADMIN_CHAT_ID=          # your personal chat_id (always receives leads)
TG_SUPER_ADMIN_IDS=        # comma-separated chat_ids with bot admin access
TG_POLLING_ENABLED=1       # 1 = long-polling, 0 = disable bot commands

# ── Email (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.yandex.ru   # e.g. smtp.yandex.ru / smtp.mail.ru / smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@yandex.ru
SMTP_PASSWORD=
SMTP_FROM=you@yandex.ru    # defaults to SMTP_USER
SMTP_TO=you@yandex.ru      # comma-separated recipients
SMTP_SSL=1                 # 1 = SSL (port 465), 0 = STARTTLS (port 587)
