# ── General ────────────────────────────────────────────────
SITE_NAME=My Site          # shown in notifications
PORT=8080                  # service port inside container
NOTIFY_SECRET=             # secret token for POST /notify (leave empty = no auth)

# ── Telegram ────────────────────────────────────────────────
TG_BOT_TOKEN=              # from @BotFather
TG_ADMIN_CHAT_ID=          # your personal chat_id (always receives leads)
TG_SUPER_ADMIN_IDS=        # extra admins, comma-separated chat_ids
TG_POLLING_ENABLED=1       # 1 = bot responds to commands, 0 = notifications only

# ── Email ───────────────────────────────────────────────────
# Pick ONE provider preset below and fill in your credentials.
# Remove or leave empty to disable email notifications.

# Yandex Mail ───
# App password: https://id.yandex.ru → Security → App passwords
SMTP_PROVIDER=yandex
SMTP_USER=you@yandex.ru
SMTP_PASSWORD=your_app_password

# Mail.ru ───
# App password: https://account.mail.ru → Security → Passwords for external apps
# SMTP_PROVIDER=mailru
# SMTP_USER=you@mail.ru
# SMTP_PASSWORD=your_app_password

# Gmail ───
# App password: https://myaccount.google.com → Security → 2FA → App passwords
# SMTP_PROVIDER=gmail
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_app_password

# Custom SMTP (overrides provider preset) ───
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SSL=1                 # 1 = SSL (port 465), 0 = STARTTLS (port 587)

# Where to send notifications ───
SMTP_FROM=you@yandex.ru    # sender address (defaults to SMTP_USER)
SMTP_TO=you@yandex.ru      # recipients, comma-separated
